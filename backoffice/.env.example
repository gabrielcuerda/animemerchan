# Back-office · Tarea 2
#
# Copia a `backoffice/.env` para ejecutar en local. No subas el .env real.

# Puerto local. En Render lo inyecta la plataforma.
PORT=4000

# PostgreSQL del back-office (proyecto Supabase separado del de la tienda).
# En local puedes usar el Session pooler o la conexión directa.
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU-REGION.pooler.supabase.com:5432/postgres
