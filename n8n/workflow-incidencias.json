        "jsCode": "const obligatorios = ['evento','incidencia_id','pedido_id','cliente_email',\n                      'telegram_chat_id','tipo','descripcion','fecha'];\n\nreturn $input.all().map(item => {\n  const d = item.json.body || {};\n  const errores = obligatorios\n    .filter(c => d[c] === undefined || d[c] === null || String(d[c]).trim() === '')\n    .map(c => `falta ${c}`);\n\n  if (d.evento && d.evento !== 'incident.created')\n    errores.push('evento no es incident.created');\n  if (d.cliente_email && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(d.cliente_email))\n    errores.push('email no válido');\n\n  return { json: { ...d, valido: errores.length === 0, errores } };\n});"
      },
