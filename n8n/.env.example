# n8n · Tarea 2
#
# Copia este fichero a .env solo para pruebas locales.
# En Render las variables se declaran en el panel del servicio.
# NUNCA subas el .env real ni las contraseñas.

# --- Render ---------------------------------------------------------
# Render enruta al puerto de PORT; n8n escucha en N8N_PORT.
# Si no coinciden, el servicio responde 502.
PORT=5678
N8N_PORT=5678

# Host público sin protocolo. En Render: tu-servicio.onrender.com
N8N_HOST=TU-SERVICIO.onrender.com
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://TU-SERVICIO.onrender.com

# Base pública de los webhooks, con barra final. En n8n 2.x el nombre nuevo es
# N8N_WEBHOOK_URL; en versiones antiguas se llama WEBHOOK_URL.
N8N_WEBHOOK_URL=https://TU-SERVICIO.onrender.com/

N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true

# Clave fija de cifrado. Genera una con: openssl rand -hex 32
# Si cambia, se pierden las credenciales guardadas en n8n.
N8N_ENCRYPTION_KEY=CAMBIAR_POR_CADENA_ALEATORIA_DE_32_O_MAS_CARACTERES

GENERIC_TIMEZONE=Europe/Madrid
TZ=Europe/Madrid

# --- Supabase (proyecto exclusivo para n8n) -------------------------
# Usa el Session pooler (Connect -> Session pooler), puerto 5432.
# No uses el Transaction pooler (6543) para las migraciones de n8n.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=aws-0-REGION.pooler.supabase.com
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=postgres
DB_POSTGRESDB_USER=postgres.TU_PROJECT_REF
DB_POSTGRESDB_PASSWORD=CAMBIAR
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
DB_POSTGRESDB_POOL_SIZE=2

# --- Workflow -------------------------------------------------------
# Back-office público, sin barra final. Los nodos HTTP lo leen con $env.
BACKOFFICE_URL=https://backoffice-tarea2.onrender.com

# Aviso opcional por Telegram en las ramas de error. Si no se configura, el
# nodo de aviso falla, pero `onError` deja seguir el flujo y la respuesta al
# webhook no se pierde. El bot es el mismo de la Persona 3.
TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# El workflow usa $env.BACKOFFICE_URL. Si esto está a true, los nodos fallan.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# En n8n 2.x los task runners vienen activados. Descomenta solo si usas una
# imagen antigua y el nodo Code falla.
# N8N_RUNNERS_ENABLED=true

# --- Ejecuciones ----------------------------------------------------
# Guarda 7 días de ejecuciones para las evidencias y poda el resto.
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all

N8N_DIAGNOSTICS_ENABLED=false
