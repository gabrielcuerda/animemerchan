# Webhook que recibe order.created y order.status_changed.
# - Sin n8n (pruebas locales): http://localhost:4000/pedidos (back-office directo)
# - Con n8n (producción):     https://TU-N8N.onrender.com/webhook/integracion-tarea2
INTEGRACION_WEBHOOK_URL=http://localhost:4000/pedidos

# Chat de Telegram que se asocia a las incidencias creadas desde la web.
# En la demo es el chat del equipo/pruebas; un cliente real de Telegram trae su
# propio chat_id en el payload. No es un secreto, pero cámbialo si usas un grupo.
INCIDENCIAS_TELEGRAM_CHAT_ID=7683478497

# Facturas por correo (opcional: sin esto el pedido se crea igual, pero no se
# envía la factura). Usa la contraseña de aplicación del buzón, no la normal.
SMTP_HOST=smtp.dondominio.com
SMTP_PORT=465
SMTP_USER=ayuda@animemerchan.onl
SMTP_PASSWORD=CAMBIAR_AQUI
EMAIL_FROM=Animemerchan <ayuda@animemerchan.onl>
EMAIL_REPLY_TO=ayuda@animemerchan.onl
EMAIL_BCC=ayuda@animemerchan.onl