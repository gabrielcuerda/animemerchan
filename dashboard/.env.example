# URL pública del back-office (se consulta desde el servidor, nunca desde el
# navegador: el back-office no envía cabeceras CORS).
BACKOFFICE_URL=https://backoffice-tarea2.onrender.com

# Opcional. Solo si el back-office llega a exigir autenticación: se envía como
# `Authorization: Bearer <token>`. No lo pongas en el repositorio.
# BACKOFFICE_TOKEN=
